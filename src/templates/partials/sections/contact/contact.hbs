<section class="contact" id="contact">
  <div class="container">
    <div class="row">
      <div class="col-12 text-center">
        <div class="title-block">
          <p class="sub-title">Write us a message</p>
          <h2 class="title">Get in touch with Us</h2>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-12">

        <div class="contact-container">
          <form class="contact-form" action="">

            <div class="contact-group">
              <label for="name">
                NAME<span>*</span>
              </label>
              <input type="text" id="name" placeholder="your name">
            </div>

            <div class="contact-group">
              <label for="email">
                E-MAIL ADDRESS<span>*</span>
              </label>
              <input type="email" id="email" placeholder="email@mail.com">
            </div>

            <div class="contact-group">
              <label for="phone">
                PHONE NUMBER
              </label>
              <input type="tel" id="phone" placeholder="+49 123 456 789">
            </div>

            <div class="contact-group">
              <label for="subject">
                SUBJECT<span>*</span>
              </label>
              <input type="text" id="subject" placeholder="subject">
            </div>

            <div class="contact-group contact-group--full">
              <label for="message">
                MESSAGE<span>*</span>
              </label>
              <textarea id="message" placeholder="type in your message"></textarea>
            </div>
            <button class="custom-btn contact-btn">submit</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

